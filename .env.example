# Copy this file to .env and replace the example values with your own.
# Never commit real API keys.

# OpenAI chat and embeddings
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Optional: generic OpenAI-compatible chat endpoint.
# Set the endpoint and model for your provider. OPENAI_API_KEY above is used
# as its API key. Leave unset to use native OpenAI chat.
# For this mode, set OPENAI_CHAT_MODEL to your provider's model instead of
# the OpenAI model above.
# OPENAI_BASE_URL=https://provider.example/v1
# OPENAI_CHAT_MODEL=your-chat-model

# Optional: Ollama chat endpoint.
# OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_API_KEY=ollama

# Optional: use an independent OpenAI-compatible retrieval embedding endpoint.
# The embedding model must match the model used to index your ChromaDB collection.
# CHROMA_OPENAI_BASE_URL=http://localhost:11434/v1
# CHROMA_OPENAI_API_KEY=ollama
